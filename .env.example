# ─────────────────────────── Required ───────────────────────────

# GEMINI_API_KEY: Required for Gemini Live AI voice calls (Google Gemini Live API).
# Must be an unrestricted key with Live API access (AQ. prefix).
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# GEMINI_LIVE_MODEL: Gemini Live model name. Required.
GEMINI_LIVE_MODEL="gemini-3.8-live"

# PORT: Port for the long-running Node server (default 3000 behind reverse proxy).
PORT="3000"

# NODE_ENV: Set to production on the server.
NODE_ENV="production"

# ─────────────────── Live relay security (recommended) ───────────────

# AURA_LIVE_TOKEN: Shared secret (minimum 16 characters) required on /live upgrade.
# When unset, the relay operates in same-origin mode.
AURA_LIVE_TOKEN="generate-a-long-random-secret-token"

# AURA_ALLOWED_ORIGINS: Extra comma-separated origins permitted to open /live (e.g. "https://yourdomain.com").
AURA_ALLOWED_ORIGINS=""

# ─────────────────── Gemini Multi-Project Pool (optional) ────────────

# Secondary API key for instant cluster failover:
# GEMINI_PROJECT_BETA_KEY="YOUR_SECONDARY_GEMINI_KEY"
# GEMINI_PROJECT_BETA_ID="my-second-gcp-project"

# Maximum concurrent sessions per Google Cloud project (default: 4):
# AURA_PROJECT_CAPACITY="4"

# ─────────────────── n8n Workflow Integration (future phase) ─────────

# N8N_MODE: "mock" (in-memory mock store) or "live" (n8n webhook workflows). Default: "mock".
N8N_MODE="mock"

# N8N_WEBHOOK_URL: Endpoint for n8n booking workflow (when N8N_MODE=live).
# N8N_WEBHOOK_URL="https://n8n.yourdomain.com/webhook/voice-booking"

# N8N_WEBHOOK_SECRET: Shared secret header for securing n8n webhooks.
# N8N_WEBHOOK_SECRET=""

# ─────────────────── Persistence & Storage ───────────────────────────

# AURA_DATA_DIR: Where local appointment and session journals are written.
AURA_DATA_DIR=".data"

# AURA_SESSION_TTL_MS: Session lifetime in milliseconds (default: 300000 = 5 min).
AURA_SESSION_TTL_MS="300000"

# AURA_PERSISTENCE_TOPOLOGY: "SINGLE_INSTANCE" on persistent VMs.
AURA_PERSISTENCE_TOPOLOGY="SINGLE_INSTANCE"
