{
  "name": "aura-voice-agent",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --target=node22 --format=esm --packages=external --sourcemap --outfile=server.mjs",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js server.mjs server.mjs.map",
    "lint": "tsc --noEmit",
    "test": "tsx -e \"import { TestRunner } from './src/testing/TestRunner'; TestRunner.runAll().then(r => { TestRunner.printReport(r); if (!r.allPassed) process.exit(1); })\"",
    "verify:relay": "tsx scripts/verifyRelaySecurity.ts",
    "verify:vercel": "tsx scripts/verifyVercelFunction.ts",
    "verify:gemini": "tsx scripts/verifyGeminiCredentials.ts",
    "verify:e2e": "tsx scripts/verifyEndToEnd.ts",
    "verify:keys": "tsx scripts/verifyKeys.ts",
    "verify:deployment": "tsx scripts/verifyDeployment.ts",
    "verify:entrypoint": "tsx scripts/verifyEntrypointSafety.ts",
    "verify:fn-bundle": "tsx scripts/verifyFunctionBundle.ts",
    "verify:all": "npm run lint && npm test && npm run verify:relay && npm run verify:vercel && npm run verify:entrypoint && npm run verify:fn-bundle && npm run build"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
