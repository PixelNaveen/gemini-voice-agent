  "faqs": [
    {
      "q": "Can you tell me which properties are available?",
      "a": "I don't have live listings on this line. An agent will share current options during your consultation or tour."
    },
    {
      "q": "Is there a fee for a valuation?",
      "a": "No, valuations and buyer advisory sessions are complimentary."
    },
    {
      "q": "What do I need for a penthouse showing?",
      "a": "Proof of funds is required before the showing."
    },
    {
      "q": "Do you work with first-time buyers?",
      "a": "Yes, we offer a First-Time Buyer Advisory session."
    },
    {
      "q": "Can I see more than one property in a tour?",
      "a": "Yes. Tell the agent which properties and they will plan a route."
    },
    {
      "q": "Can I get a price estimate for my home?",
      "a": "Our valuation session provides a market-based estimate. I can't quote a value by phone."
    }
  ],
