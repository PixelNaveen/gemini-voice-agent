  "faqs": [
    {
      "q": "Do you take walk-ins?",
      "a": "Walk-ins are welcome when a stylist is free, but booking guarantees your time."
    },
    {
      "q": "How long does balayage take?",
      "a": "Plan on about two and a half hours."
    },
    {
      "q": "Do you offer a discount for multiple services?",
      "a": "Yes, 10% off when you book two or more services in one visit."
    },
    {
      "q": "Is parking available?",
      "a": "There is no private lot. Public garages are on Lexington and East 41st Street."
    },
    {
      "q": "Can I request a specific stylist?",
      "a": "Yes, and I can check that stylist's availability for you."
    },
    {
      "q": "What if I'm running late?",
      "a": "We hold your slot for up to 15 minutes. After that we may need to shorten or reschedule."
    }
