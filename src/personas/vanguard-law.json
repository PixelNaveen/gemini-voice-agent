  "faqs": [
    {
      "q": "Is the consultation confidential?",
      "a": "Yes, initial consultations are confidential."
    },
    {
      "q": "Can you tell me if I have a case?",
      "a": "I can't give legal advice. An attorney can discuss that in a consultation."
    },
    {
      "q": "Which attorney handles contracts?",
      "a": "Alexander Reed handles commercial contract review."
    },
    {
      "q": "Who handles wills and trusts?",
      "a": "Natalie Brooks handles estate planning."
    },
    {
      "q": "What should I bring?",
      "a": "Any relevant documents, such as the contract or existing estate papers."
    },
    {
      "q": "Do you handle criminal cases?",
      "a": "I'd suggest speaking with the office directly. I can give you the main number."
    }
