  "faqs": [
    {
      "q": "Do you need my vehicle's make, model and year?",
      "a": "Yes, we collect that when booking so the shop can prepare."
    },
    {
      "q": "How long does an oil change take?",
      "a": "About 45 minutes."
    },
    {
      "q": "Do you offer towing?",
      "a": "We don't tow. For towing requests I can give you the shop number."
    },
    {
      "q": "Is a diagnostic scan the same as a repair?",
      "a": "No. The scan finds the cause, and any repair is quoted separately."
    },
    {
      "q": "Do you work on all makes?",
      "a": "Please tell me your vehicle and the shop will confirm."
    },
    {
      "q": "Do I have to wait during service?",
      "a": "You can wait or drop off the vehicle. Let the advisor know at check-in."
    }
