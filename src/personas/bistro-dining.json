  "faqs": [
    {
      "q": "Do you accommodate dietary restrictions?",
      "a": "Yes, please tell me and I'll add it to your reservation notes. For severe allergies, the manager will confirm with you."
    },
    {
      "q": "What time does the kitchen close?",
      "a": "Please ask me the day and I'll give you the exact closing hours."
    },
    {
      "q": "How large a party can you seat?",
      "a": "The main dining room handles most parties. For more than 10 guests, the manager arranges it."
    },
    {
      "q": "Is there a dress code?",
      "a": "Smart casual is recommended."
    },
    {
      "q": "Is the tasting menu fixed?",
      "a": "Yes, it is a seven-course chef's menu at $195 per guest."
    },
    {
      "q": "How long do I keep my table if I'm late?",
      "a": "We hold it for 15 minutes."
    }
